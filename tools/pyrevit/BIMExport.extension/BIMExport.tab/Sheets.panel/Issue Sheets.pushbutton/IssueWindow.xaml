<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Issue Sheets  ·  by Lew" Width="1380" Height="840" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5" FontFamily="Segoe UI" FontSize="12.5">
<Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
        <SolidColorBrush x:Key="AccentDark" Color="#174A84"/>
        <SolidColorBrush x:Key="Ink" Color="#1F2933"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7785"/>
        <SolidColorBrush x:Key="Line" Color="#D9DEE5"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
            <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="22,14">
            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Issue Sheets" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="  by Lew" FontSize="12" Foreground="#D3E2F4" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Check what changed, fix revisions and title block switches, then issue with exact MIDP file names."
                               Foreground="#D3E2F4" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Background  " Foreground="#D3E2F4" VerticalAlignment="Center"/>
                        <Border x:Name="bg_badge_bd" CornerRadius="10" Padding="10,2" Background="#6B7785">
                            <TextBlock x:Name="bg_badge_tb" Text="NOT RUNNING" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="bg_msg_tb" Foreground="#D3E2F4" TextAlignment="Right" FontStyle="Italic" FontSize="11.5" Margin="0,3,0,0"/>
                    <TextBlock x:Name="header_info" Foreground="#D3E2F4" TextAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Close" Style="{StaticResource Secondary}" Click="on_close"/>
                    <Button Content="&#x26A1; Prepare" Style="{StaticResource Secondary}" Click="on_prepare"
                            ToolTip="The background Revit opens the models of the ticked drawings now and keeps them open, so Issue prints them in seconds."/>
                    <Button Content="Dry run" Style="{StaticResource Secondary}" Click="on_dryrun"
                            ToolTip="Instant: shows the file names and writes nothing to the issue register."/>
                    <Button Content="Issue" Style="{StaticResource Primary}" Click="on_issue"/>
                </StackPanel>
                <TextBlock x:Name="status_tb" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="col_left" Width="290" MinWidth="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="col_right" Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- 1 models + sets + MIDP -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="1   Models" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Saved set" Style="{StaticResource Label}" Margin="0,4,0,4"/>
                        <DockPanel>
                            <Button Content="Delete" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="on_set_delete"/>
                            <Button Content="Save" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="on_set_save"/>
                            <ComboBox x:Name="sets_cb" SelectionChanged="on_set_pick"/>
                        </DockPanel>
                        <TextBox x:Name="model_search" TextChanged="on_model_search" Margin="0,10,0,0" ToolTip="Filter models"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="MIDP / LOD (CSV)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button Content="Browse..." Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="on_midp_browse"/>
                            <TextBox x:Name="midp_tb" IsReadOnly="True"/>
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Content="&#x27F3; Reload ticked" Style="{StaticResource Secondary}" Margin="0,0,3,0" Click="on_reload_ticked"
                                    ToolTip="The background Revit reloads the ticked models fully NOW (your Revit stays free). Lines show the progress; the drawings refresh here when each is done. Then Issue prints them in seconds."/>
                            <Button Content="&#x26A1; Keep ready" Style="{StaticResource Secondary}" Margin="3,0,0,0" Click="on_keep_ready"
                                    ToolTip="Keep the ticked models open in the background Revit all the time (refreshed at every check) - they always print in seconds. Click again to stop."/>
                        </UniformGrid>
                        <Button Content="Check models  &#x25B6;" Style="{StaticResource Primary}" Margin="0,6,0,0" Click="on_check"
                                ToolTip="Models already checked load instantly. This reads only models never read (quick open here)."/>
                        <TextBlock x:Name="model_info_tb" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="models_lb" Margin="0,8,0,0" BorderBrush="{StaticResource Line}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <!-- 2 work area -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="tabs" BorderBrush="{StaticResource Line}">
                    <TabItem Header="  Drawings  ">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Button Content="Tick changed" Style="{StaticResource Small}" Click="on_tick_changed"/>
                                    <Button Content="Tick all" Style="{StaticResource Small}" Click="on_tick_all"/>
                                    <Button Content="Clear" Style="{StaticResource Small}" Click="on_untick_all"/>
                                    <CheckBox x:Name="show_tb_cb" Content="Title block column" VerticalAlignment="Center" Click="on_show_tb"/>
                                </StackPanel>
                                <TextBox x:Name="sheet_search" TextChanged="on_sheet_search" ToolTip="Filter by number, name or status"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="File name = MIDP code (first 7 parts) + Revit's current revision. BLOCKED rows are never exported. Click a row to see it in Revisions and Title blocks."/>
                            <DataGrid x:Name="sheets_dg" AutoGeneratingColumn="on_autocol" SelectionChanged="on_sheet_select"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="  Revisions  ">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Model  " VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="rev_model_cb" MinWidth="260" SelectionChanged="on_rev_model"/>
                                <Button Content="+ Add revision" Style="{StaticResource Small}" Margin="10,0,0,0" Click="on_add_rev"/>
                                <Button Content="Remove clouds..." Style="{StaticResource Small}" Margin="6,0,0,0" Click="on_remove_clouds"
                                        ToolTip="Delete the revision clouds of one revision on the drawings shown below (waits for Apply; Revert puts them back)."/>
                                <TextBlock Text="Numbering:" Margin="14,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="numbering_cb" MinWidth="110" SelectionChanged="on_numbering"
                                          ToolTip="Same as Revit's Sheet Issues/Revisions 'Numbering'. Per sheet: each drawing counts only its own revisions (T0, T2 ticked = T0, T1)."/>
                                <TextBlock x:Name="rev_info_tb" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Sheet Issues / Revisions (Revit's own numbering). Issued revisions are locked by Revit."
                                       Style="{StaticResource Hint}"/>
                            <DataGrid x:Name="revs_dg" DockPanel.Dock="Top" MaxHeight="220" AutoGeneratingColumn="on_autocol_revs"/>
                            <TextBlock DockPanel.Dock="Top" Text="Revisions on drawings - tick like Revit's 'Revisions on Sheet'. Current rev and date update as you tick (clouded revisions can't be removed)."
                                       Style="{StaticResource Hint}" Margin="0,10,0,6"/>
                            <DataGrid x:Name="onsheet_dg" AutoGeneratingColumn="on_autocol_onsheet"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="  Title blocks  ">
                        <DockPanel Margin="8">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Change to" Grid.Row="2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="tb_change_cb" Grid.Row="2" Grid.Column="1" Margin="0,2"
                                          ToolTip="Any title block type loaded in this model (same family or another family)"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Change this drawing" Style="{StaticResource Small}" Click="on_tb_change_one"/>
                                    <Button Content="Change all ticked drawings" Style="{StaticResource Small}" Click="on_tb_change_ticked"/>
                                    <Button Content="Undo for this drawing" Style="{StaticResource Small}" Click="on_tb_change_undo"/>
                                    <CheckBox x:Name="tb_keep_cb" Content="Keep Yes/No switches with the same name" IsChecked="True"
                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Drawing" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="tb_sheet_cb" Grid.Column="1" Margin="0,2" SelectionChanged="on_tb_sheet"/>
                                <TextBlock Text="Title block" Grid.Row="1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="tb_inst_cb" Grid.Row="1" Grid.Column="1" Margin="0,2" SelectionChanged="on_tb_inst"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" x:Name="tb_info_tb" Style="{StaticResource Hint}"/>
                            <TextBlock DockPanel.Dock="Top" Text="Revisions on this drawing" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <DataGrid x:Name="tb_revs_dg" DockPanel.Dock="Top" MaxHeight="170" IsReadOnly="True" AutoGeneratingColumn="on_autocol_plain"/>
                            <TextBlock DockPanel.Dock="Top" Text="Title block Yes/No parameters (only these can be changed; a TYPE parameter changes every drawing using that type)"
                                       FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                            <DataGrid x:Name="params_dg" AutoGeneratingColumn="on_autocol_params"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="  Changes  ">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Apply to the models" Style="{StaticResource Primary}" Margin="0,0,6,0" Click="on_apply"/>
                                <Button Content="Discard all" Style="{StaticResource Secondary}" Click="on_discard"/>
                                <Button Content="Revert last apply..." Style="{StaticResource Secondary}" Click="on_revert"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                       Text="Nothing is changed in Revit until Apply. Apply opens a local copy, checks nobody else owns the items, makes all changes in one step, reads them back, then syncs and gives back everything borrowed. Any problem: nothing is saved."/>
                            <TextBox x:Name="changes_tb" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 3 settings: same tabs as Export Sheets -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="3   Settings" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Saved for next time (shared with Export Sheets)." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TabControl BorderBrush="{StaticResource Line}">
                        <TabItem Header="  Output  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Save to" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button Content="Browse..." Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="on_browse"/>
                                        <TextBox x:Name="out_tb"/>
                                    </DockPanel>
                                    <CheckBox x:Name="per_model_cb" Content="One folder per model" Margin="0,8,0,0"/>
                                    <TextBlock Text="Issue register (one CSV for every print)" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button Content="Browse..." Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="on_register_browse"/>
                                        <TextBox x:Name="register_tb"/>
                                    </DockPanel>
                                    <TextBlock Text="Formats" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="pdf_cb" Content="PDF"/>
                                    <CheckBox x:Name="dwg_cb" Content="DWG (CAD)"/>
                                    <TextBlock Text="File names" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="names_info_tb" Style="{StaticResource Hint}"/>
                                    <CheckBox x:Name="allow_norev_cb" Content="With a MIDP: allow drawings without a revision"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  PDF  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Export setup" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="pdf_setup_cb" SelectionChanged="on_pdf_setup"/>
                                    <TextBlock x:Name="pdf_setup_info" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                    <TextBlock Text="Size" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Page size" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_paper_cb" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Orientation" Grid.Row="1" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_orient_cb" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Placement" Grid.Row="2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_place_cb" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Zoom" Grid.Row="3" VerticalAlignment="Center"/>
                                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                                            <TextBox x:Name="pdf_zoom_tb" Width="50" DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="% size when Zoom is chosen"/>
                                            <ComboBox x:Name="pdf_zoom_cb"/>
                                        </DockPanel>
                                    </Grid>

                                    <TextBlock Text="Appearance" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Raster quality" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_raster_cb" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Colours" Grid.Row="1" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_colors_cb" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Processing" Grid.Row="2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="pdf_proc_cb" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                                    </Grid>

                                    <TextBlock Text="Options" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="pdf_links_blue_cb" Content="View links in blue (colour prints only)"/>
                                    <CheckBox x:Name="pdf_hide_ref_cb" Content="Hide ref/work planes"/>
                                    <CheckBox x:Name="pdf_hide_tags_cb" Content="Hide unreferenced view tags"/>
                                    <CheckBox x:Name="pdf_mask_cb" Content="Region edges mask coincident lines"/>
                                    <CheckBox x:Name="pdf_hide_scope_cb" Content="Hide scope boxes"/>
                                    <CheckBox x:Name="pdf_hide_crop_cb" Content="Hide crop boundaries"/>
                                    <CheckBox x:Name="pdf_halftone_cb" Content="Replace halftone with thin lines"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  CAD  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Export setup" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="dwg_setup_cb" SelectionChanged="on_dwg_setup"/>
                                    <TextBlock x:Name="dwg_setup_info" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="DWG version" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="dwg_version_cb" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Layers" Grid.Row="1" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="dwg_layers_cb" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                                        <TextBlock Text="Colours" Grid.Row="2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="dwg_colors_cb" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                                    </Grid>
                                    <CheckBox x:Name="dwg_merged_cb" Content="One DWG per sheet (views not as xrefs)" Margin="0,10,0,4"/>
                                    <CheckBox x:Name="dwg_shared_cb" Content="Shared coordinates"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="With a setup chosen, each model uses its own copy of that setup. The values shown come from the first model that has it."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  Background  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="A separate Revit checks models at set times and keeps some open, so printing them takes seconds."/>
                                    <TextBlock Text="Check on schedule" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="bg_watch_tb" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    <Button Content="Use the ticked models" Style="{StaticResource Small}" HorizontalAlignment="Left" Click="on_bg_watch"
                                            ToolTip="The models ticked on the left become the ones checked at the times below."/>
                                    <TextBlock Text="Times" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="bg_times_tb" ToolTip="As many as you like, e.g. 07:00, 10:00, 12:30, 15:00, 18:00"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox x:Name="bgd1" Content="Mon" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd2" Content="Tue" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd3" Content="Wed" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd4" Content="Thu" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd5" Content="Fri" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd6" Content="Sat" Margin="0,4,8,4"/>
                                        <CheckBox x:Name="bgd7" Content="Sun" Margin="0,4,8,4"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="bg_on_cb" Content="Schedule on"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Keep" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="bg_keep_cb" Width="52" Margin="6,0"/>
                                        <TextBlock Text="more models open (besides Keep ready)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Print ahead" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="bg_pre_cb" Content="Print changed drawings in advance"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0" TextWrapping="Wrap"
                                               Text="During each check, with your PDF / CAD settings. Issue then copies them in seconds if the drawing has not changed since."/>
                                    <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                                        <TextBlock Text="Delete printouts not used for" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="bg_pre_days_cb" Width="52" Margin="6,0"/>
                                        <TextBlock Text="days" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Save schedule" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="on_bg_save"/>
                                    <TextBlock x:Name="bg_saved_tb" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="Control" Style="{StaticResource Label}"/>
                                    <WrapPanel>
                                        <Button Content="Check now" Style="{StaticResource Small}" Margin="0,0,6,6" Click="on_bg_check_now"/>
                                        <Button x:Name="bg_pause_btn" Content="Pause" Style="{StaticResource Small}" Margin="0,0,6,6" Click="on_bg_pause"/>
                                        <Button Content="Stop" Style="{StaticResource Small}" Margin="0,0,6,6" Click="on_bg_stop"/>
                                        <Button Content="What changed" Style="{StaticResource Small}" Margin="0,0,6,6" Click="on_bg_changes"/>
                                        <Button Content="Open for work..." Style="{StaticResource Small}" Margin="0,0,6,6" Click="on_bg_open_work"
                                                ToolTip="Open the SELECTED model line for work: in this Revit or in a new Revit window."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="bg_last_tb" Style="{StaticResource Hint}" TextWrapping="Wrap" FontStyle="Italic"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  Run  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Logos" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="embed_cb" Content="Embed logos in the DWGs (AutoCAD)"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0"
                                               Text="AutoCAD starts while Revit is still exporting."/>
                                    <TextBlock Text="Speed" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <TextBlock Text="Open" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="extra_cb" Width="48" Margin="6,0"/>
                                        <TextBlock Text="extra Revit windows to print in parallel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="Each prints its own model at the same time (3 models + 2 extra = about 3x faster). They join by themselves and close when done. 2 extra is safe with 64 GB."/>
                                    <CheckBox x:Name="share_cb" Content="Share with other Revit windows"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0" TextWrapping="Wrap"
                                               Text="Open another Revit, click Issue Sheets there and choose Join. Each window prints the next model (2-3 windows = 2-3x faster)."/>
                                    <CheckBox x:Name="fresh_cb" Content="Always open models fresh when printing"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0" TextWrapping="Wrap"
                                               Text="Off (normal): models open in the background Revit print from there in seconds (the model as of its last check). On: always open the latest version."/>
                                    <CheckBox x:Name="skip_links_cb" Content="Faster: don't load linked models"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0"
                                               Text="Only for drawings that do NOT show linked content."/>
                                    <TextBlock Text="Safety" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="allow_nonws_cb" Content="Allow non-workshared models"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Printing opens every model detached with ALL worksets and closes without saving."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
