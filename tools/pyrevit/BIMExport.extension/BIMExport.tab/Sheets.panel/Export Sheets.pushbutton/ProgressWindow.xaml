<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Export  ·  Exporting" Width="820" Height="680" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5"
        FontFamily="Segoe UI" FontSize="12.5" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
        <SolidColorBrush x:Key="Line" Color="#D9DEE5"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7785"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="10,10,10,0"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="20,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="title_tb" Text="Exporting" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="  by Lew" FontSize="12" Foreground="#D3E2F4" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </StackPanel>
                <TextBlock x:Name="sub_tb" Foreground="#D3E2F4" Margin="0,2,0,0"
                           Text="Models open detached and close without saving. You can work in other programs meanwhile."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="16,10" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="open_btn" Content="Open folder" Style="{StaticResource Btn}" Click="on_open" Visibility="Collapsed"/>
                    <Button x:Name="close_btn" Content="Close" Style="{StaticResource Btn}" Click="on_close_done" Visibility="Collapsed"/>
                    <Button x:Name="cancel_btn" Content="Cancel" Style="{StaticResource Btn}" Click="on_cancel"/>
                </StackPanel>
                <TextBlock x:Name="status_tb" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- models -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="models_count_tb" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="Models" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ProgressBar x:Name="overall_pb" Margin="0,8,0,8"/>
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="models_sp"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- current model -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock x:Name="sheets_count_tb" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="current_tb" Text="Now exporting" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="phase_tb" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="sheet_pb" Margin="0,8,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drawing" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="2" Text="PDF" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="3" Text="DWG" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer x:Name="sheets_sv" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="sheets_sp"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
