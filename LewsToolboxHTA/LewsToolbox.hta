<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>Lew's Toolbox</title>
<hta:application id="ltApp" applicationname="LewsToolbox" icon="LewsToolbox.ico" border="thick" caption="yes"
  showintaskbar="yes" singleinstance="yes" scroll="no" contextmenu="no" innerborder="no" selection="no"
  maximizebutton="yes" minimizebutton="yes" />
<!--
  Lew's Toolbox - launcher, tasks, delegation, transmittals, drawing checks and bulk files.
  Plug and play like QuickLaunch: keep this file with its "core" and "tabs" folders, double-click it.
  Each tab is its own file in "tabs" - this window finds them by itself.
-->
<style>
#shell{display:flex;height:100%}
#nav{flex:none;width:220px;display:flex;flex-direction:column;padding:12px 10px 10px;overflow:hidden;transition:width .25s ease-out}
#brand{display:flex;align-items:center;font-weight:600;font-size:15px;padding:2px 4px 18px;white-space:nowrap}
#brand .logo{flex:none;width:32px;height:32px;line-height:32px;text-align:center;border-radius:9px;font-weight:700;font-size:13px;letter-spacing:.5px;margin-right:10px}
#railBtn{margin-left:auto;width:26px;height:26px;padding:0;cursor:pointer;font:inherit;font-size:12px;line-height:24px;text-align:center;outline:none;border-radius:6px}
#shell.rail #nav{width:64px}#shell.rail .tx{display:none}#shell.rail #brand{flex-direction:column;padding-bottom:12px}#shell.rail #brand .logo{margin:0 0 8px}#shell.rail #railBtn{margin:0}
#shell.rail .nb{justify-content:center;padding:0}#shell.rail .nb svg.ic,#shell.rail .nb span.ic{margin:0}
#tabsWrap{flex:1 1 auto;position:relative;min-height:0;display:flex;flex-direction:column}
#tabs{flex:1 1 auto;overflow-y:auto;overflow-x:hidden;position:relative;z-index:1}
#pill{position:absolute;left:0;right:0;top:0;bottom:100%;border-radius:12px;z-index:0;display:none}
.nbadge{margin-left:auto;min-width:20px;height:20px;line-height:20px;padding:0 6px;border-radius:99px;font-size:.75em;font-weight:700;text-align:center}#shell.rail .nbadge{display:none}
#body iframe.enter{animation:ltIn .38s cubic-bezier(.2,.8,.2,1)}
@keyframes ltIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
#newB{display:flex;align-items:center;height:38px;padding:0 14px 0 10px;margin-left:8px;border-radius:99px;cursor:pointer;font:inherit;font-weight:600;outline:none}
#newB svg{margin-right:6px}
#tsw{display:flex;align-items:center;height:38px;padding:3px;margin-left:8px;border-radius:99px}
#tsw span{width:32px;height:32px;line-height:32px;text-align:center;border-radius:50%;cursor:pointer}#tsw span svg{vertical-align:-4px}
#meBox{display:flex;align-items:center;height:42px;padding:0 12px 0 4px;margin-left:8px;border-radius:99px;cursor:pointer;white-space:nowrap}
#meBox .mn{margin-left:9px;line-height:1.15;font-size:.9em}#meBox .mn b{font-weight:600;display:block}#meBox .mn small{font-size:.8em}
#shell.float{padding:12px}#shell.float #nav{border-radius:22px;margin-right:12px}#shell.float #top{padding:0 4px 10px 2px;height:58px}#shell.float #body{border-radius:20px;overflow:hidden}
.nb{display:flex;align-items:center;width:100%;height:38px;margin:0 0 2px;padding:0 12px;cursor:pointer;font:inherit;font-weight:500;white-space:nowrap;overflow:hidden;outline:none;border:0;border-radius:9px;text-align:left}
.nb svg.ic,.nb span.ic{flex:none;margin-right:12px}.nb span.ic{width:20px;text-align:center}
.ng{margin:14px 12px 6px;font-size:.7em;font-weight:700;letter-spacing:1px;text-transform:uppercase;white-space:nowrap;min-height:1px}#shell.rail .ng{margin:10px 8px;height:1px}
#clock{flex:none;display:flex;align-items:center;height:38px;padding:0 14px;margin-left:12px;border-radius:99px;white-space:nowrap;font-size:.9em}#clock .cdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px}
#main{flex:1 1 auto;display:flex;flex-direction:column;min-width:0}
#top{flex:none;height:56px;display:flex;align-items:center;padding:0 18px 0 14px}
#proj{display:flex;align-items:center;height:38px;padding:0 12px;cursor:pointer;border-radius:9px;max-width:320px;white-space:nowrap;overflow:hidden}
#proj .pl{margin:0 8px 0 10px;line-height:1.15}#proj .pl small{display:block;font-size:.72em;font-weight:600;letter-spacing:.6px;text-transform:uppercase}#proj b{font-weight:600}
#sbox{flex:0 1 440px;display:flex;align-items:center;height:38px;margin-left:14px;padding:0 12px;cursor:text;border-radius:9px;white-space:nowrap;overflow:hidden}
#sbox span{margin-left:10px}#sbox kbd{margin-left:auto;font:11px Consolas,monospace;padding:2px 6px;border-radius:5px}
#topSp{flex:1 1 auto}
.tb{position:relative;width:38px;height:38px;margin-left:4px;cursor:pointer;border:0;border-radius:9px;background:transparent;outline:none;text-align:center}
#bellN{display:none;position:absolute;right:3px;top:3px;min-width:17px;height:17px;line-height:17px;padding:0 4px;font-size:10px;font-weight:700;border-radius:9px}
#me{flex:none;width:34px;height:34px;line-height:34px;text-align:center;border-radius:50%;margin-left:10px;font-weight:700;font-size:12px;cursor:pointer}
#body{flex:1 1 auto;position:relative;min-width:0}
#body iframe{position:absolute;left:0;top:0;width:100%;height:100%;border:0;display:none}
#tip{display:none;position:fixed;z-index:50;width:280px;padding:10px 12px;line-height:1.45;font-size:13px}
#tip b{display:block;margin-bottom:3px}
#warn{display:none;position:absolute;left:0;right:0;top:0;z-index:5;padding:8px 12px;font-weight:bold;background:#b13e53;color:#fff}
#dataWarn{display:none;flex:none;margin:6px 2px;padding:7px 8px;font-size:.85em;line-height:1.35;background:#fff4d6;color:#5a4200;border:1px solid #e5c36a;border-radius:8px}
#dataWarn .wb{display:inline-block;margin:5px 4px 0 0;padding:2px 7px;font:inherit;font-weight:bold;cursor:pointer;border:1px solid #c9a646;background:#fff;color:#5a4200;border-radius:6px}
#shell.rail #dataWarn{padding:4px;text-align:center}
#lo{display:none;position:fixed;left:0;top:0;right:0;bottom:0;z-index:62;background:rgba(0,0,0,.35)}
#loBox{width:760px;max-width:94%;max-height:90%;overflow-y:auto;margin:30px auto 0;padding:14px 18px;line-height:1.45}#loBox h3{margin:0 0 4px}
#loBox .lf{display:inline-block;margin:0 10px 6px 0;vertical-align:top}#loBox .lf label{display:block;font-size:.8em;font-weight:bold;opacity:.75}#loBox input[type=text],#loBox select{height:26px;width:200px}
#loList{max-height:260px;overflow-y:auto;margin:6px 0}#loList label{display:block;padding:3px 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pk{display:block;padding:6px 8px;margin:0 0 4px;cursor:pointer}.pk input{margin-right:6px}.pk small{display:block;margin-left:22px;opacity:.75}
#loBox .acts{margin-top:10px;text-align:right}#loBox .acts button{margin-left:6px;padding:5px 12px;font:inherit;font-weight:bold;cursor:pointer}
#qs{display:none;position:fixed;left:0;top:0;right:0;bottom:0;z-index:60;background:rgba(0,0,0,.35)}
#qsBox{width:640px;max-width:92%;margin:60px auto 0;padding:10px}
#qsIn{width:100%;height:36px;font-size:1.1em;padding:0 10px}
#qsRes{max-height:420px;overflow-y:auto;margin-top:8px}
.qr{padding:6px 10px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qr .k{display:inline-block;width:94px;font-size:.8em;font-weight:bold}.qr .c{font-family:Consolas,'Lucida Console',monospace;margin-right:6px}.qr .s{font-size:.85em;margin-left:8px}
#qsHint{font-size:.8em;margin-top:6px}
#wn{display:none;position:fixed;left:0;top:0;right:0;bottom:0;z-index:61;background:rgba(0,0,0,.35)}
#wnBox{width:600px;max-width:92%;max-height:80%;overflow-y:auto;margin:50px auto 0;padding:16px 20px;line-height:1.5}#wnBox h3{margin:0 0 4px}#wnBox ul{margin:8px 0 12px;padding-left:20px}#wnBox li{margin-bottom:5px}#wnBox .v{font-size:.85em}
#remind{display:none;position:fixed;right:16px;top:60px;z-index:45;width:350px;padding:14px 16px;line-height:1.5}
#remind h4{margin:0 20px 6px 0;font-size:1.05em;font-weight:600}#remind ul{margin:0 0 8px;padding-left:18px}#remind .rb{margin:4px 6px 0 0;padding:4px 11px;font:inherit;font-weight:600;cursor:pointer}
#remind .rx{position:absolute;right:12px;top:10px;cursor:pointer;font-weight:bold}
#pm{display:none;position:fixed;z-index:46;width:330px;padding:8px}#pm .pi{display:flex;align-items:center;padding:8px 10px;cursor:pointer;border-radius:8px}#pm .pi svg{margin-right:10px}#pm .pi small{margin-left:auto}#pm .sep{height:1px;margin:6px 4px}#pm .ph{padding:6px 10px 4px;font-size:.72em;font-weight:700;letter-spacing:.8px;text-transform:uppercase}
@media (max-width:760px){ #nav{width:64px} .tx{display:none} #railBtn{display:none} #sbox span,#sbox kbd,#clock{display:none} }
</style>
<script src="core/lt-core.js"></script>
<script src="core/lt-taskfolder.js"></script>
<script src="core/lt-transmittal.js"></script>
</head>
<body>
<div id="shell">
  <div id="nav">
    <div id="brand"><span class="logo">LT</span><span class="tx">Lew's Toolbox</span><button id="railBtn" title="Fold the menu to icons / open it again (Ctrl+[)">&#8249;</button></div>
    <div id="tabsWrap"><div id="pill"></div><div id="tabs"></div></div>
    <div id="dataWarn"></div>
  </div>
  <div id="main">
    <div id="top">
      <div id="proj" title="The project you're working on - every tab follows it"></div>
      <div id="sbox" title="Search everything (Ctrl+K)"></div>
      <div id="topSp"></div>
      <span id="clock"><i class="cdot"></i><span id="clkD"></span> &middot; <b id="clkT">--:--</b></span>
      <button id="newB" title="New task, transmittal or project"></button>
      <div id="tsw" title="Light / dark"><span id="tsL"></span><span id="tsD"></span></div>
      <button class="tb" id="bellB" title="Today: what's due, what's late (yours and the team's)"><span id="bellN"></span></button>
      <button class="tb" id="themeB" title="Light / dark" style="display:none"></button>
      <div id="meBox" title="Settings"><div id="me"></div><div class="mn"><b id="meN"></b><small id="meR"></small></div></div>
    </div>
    <div id="body"><div id="warn"></div></div>
  </div>
</div>
<div id="remind"></div>
<div id="pm"></div>
<div id="tip"></div>
<div id="wn"><div id="wnBox"></div></div>
<div id="lo"><div id="loBox"></div></div>
<div id="qs"><div id="qsBox"><input type="text" id="qsIn" placeholder="Search tasks, drawings, transmittals, people, files, tabs..."><div id="qsRes"></div><div id="qsHint">&uarr; &darr; pick &middot; Enter = open &middot; Esc = close &middot; Ctrl+K from any tab</div></div></div>
<script>
/* ================================================================
   Main window. Finds every tab page in the "tabs" folder (each page says its own name and order
   in its <title> and <meta name="lt-order">), shows them in the side menu and loads each one
   the first time it is opened.
   ================================================================ */
var fso = LT.fso, APP = LT.appDir(), SELF = LT.pathFromUrl(location.href);
var tabs = [], frames = {}, current = null, tipsOn = true;
/* each tab's icon (line icons, core\lt-core.js L.ICONS); a tab not listed here keeps its own (emoji) icon */
var ICON_OF = { home: "home", launcher: "launch", tracker: "taskcheck", delegate: "delegate", transmittal: "transmittal", register: "register", check: "check", find: "find", superseded: "superseded", files: "files", folders: "folders", report: "report", settings: "settings" };

/* reads the name / order / icon of each tabs\*.html without opening it */
function findTabs() {
  var list = [], dir = APP + "\\tabs";
  if (!fso.FolderExists(dir)) return list;
  var e = new Enumerator(fso.GetFolder(dir).Files);
  for (; !e.atEnd(); e.moveNext()) {
    var f = e.item(), n = "" + f.Name;
    if (!/\.html?$/i.test(n)) continue;
    var head = "";
    try { var t = fso.OpenTextFile(f.Path, 1, false, 0); head = t.AtEndOfStream ? "" : t.Read(3000); t.Close(); } catch (x) { continue; }
    var title = /<title>([^<]*)<\/title>/i.exec(head), order = /<meta name="lt-order" content="(\d+(?:\.\d+)?)"/i.exec(head), icon = /<meta name="lt-icon" content="([^"]*)"/i.exec(head), desc = /<meta name="lt-desc" content="([^"]*)"/i.exec(head), grp = /<meta name="lt-group" content="([^"]*)"/i.exec(head);
    list.push({ key: n.replace(/\.html?$/i, "").toLowerCase(), file: f.Path, title: title ? title[1] : n, order: order ? +order[1] : 99, icon: icon ? icon[1] : "&#9679;", desc: desc ? desc[1] : "", group: grp ? grp[1] : "" });
  }
  list.sort(function (a, b) { return a.order - b.order || (a.title < b.title ? -1 : 1); });
  return list;
}

function findTab(k) { for (var i = 0; i < tabs.length; i++) if (tabs[i].key == k) return tabs[i]; return null; }
/* the item you're on: only the classes change (the menu isn't rebuilt on every click) */
function navMark() {
  var bs = LT.$("tabs").getElementsByTagName("button"), n = 0, i; for (i = 0; i < bs.length; i++) if (bs[i].getAttribute("data-k")) n++;
  if (n != tabs.length) { renderNav(); return; }
  for (i = 0; i < bs.length; i++) { var k = bs[i].getAttribute("data-k"); if (!k) continue; bs[i].className = "nb" + (k == current ? " on" : ""); }
}
function renderNav() {
  var h = "", g = "";
  for (var i = 0; i < tabs.length; i++) {
    // a small heading where the group changes (WORK / DRAWINGS / FILES); "-" = just a line
    if (tabs[i].group != g) { g = tabs[i].group; if (g) h += '<div class="ng">' + (g == "-" ? "" : '<span class="tx">' + LT.esc(g) + "</span>") + "</div>"; }
    h += '<button class="nb' + (tabs[i].key == current ? " on" : "") + '" data-k="' + tabs[i].key + '" title="' + (tipsOn ? "" : LT.esc(tabs[i].title) + (i < 9 ? " (Ctrl+" + (i + 1) + ")" : "")) + '">' + (ICON_OF[tabs[i].key] ? LT.icon(ICON_OF[tabs[i].key], 19) : '<span class="ic">' + tabs[i].icon + "</span>") + '<span class="tx">' + LT.esc(tabs[i].title) + "</span></button>"; }
  LT.$("tabs").innerHTML = h || '<div class="muted" style="padding:8px">The "tabs" folder is missing. Keep LewsToolbox.hta together with its "core" and "tabs" folders.</div>';
}

/* tabs that now live inside another tab: [the tab, what to tell it] */
var MOVED = { find: ["check", "view", "find"], superseded: ["check", "view", "superseded"], report: ["home", "report", ""] };
function show(key) {
  if (MOVED[key] && !findTab(key)) { var mv = MOVED[key]; LTMain.send(mv[0], mv[1], mv[2]); return; }
  var t = null;
  for (var i = 0; i < tabs.length; i++) if (tabs[i].key == key) t = tabs[i];
  if (!t) t = tabs[0];
  if (!t) return;
  if (!frames[t.key]) {
    // application="yes" lets the tab page use Windows (files, Excel) like this window
    LT.$("body").insertAdjacentHTML("beforeend", '<iframe application="yes" id="f_' + t.key + '" src="tabs/' + encodeURI(t.file.substring(t.file.lastIndexOf("\\") + 1)) + '"></iframe>');
    frames[t.key] = LT.$("f_" + t.key);
  }
  for (var k in frames) if (frames.hasOwnProperty(k)) { frames[k].style.display = (k == t.key ? "block" : "none"); if (k == t.key && current != t.key) { if (LT.smooth()) frames[k].className = ""; else { frames[k].className = ""; void frames[k].offsetWidth; frames[k].className = "enter"; } } }
  current = t.key;
  navMark(); movePill(true);
  var s = LT.settings(); s.lastTab = current; LT.saveSettings(s);
  try { var w = frames[t.key].contentWindow; if (w && w.ltShown) w.ltShown(); } catch (x) { }
  try { frames[t.key].focus(); } catch (x) { }
}

/* what the tab pages can call: LT.main().show("files"), .send("files","open-folder",path), .themeChanged() */
var LTMain = {
  show: show,
  showIndex: function (n) { if (tabs[n]) show(tabs[n].key); },
  /* opens a tab and hands it a message, e.g. Launcher -> Bulk Files "open-folder" */
  background: function () { background(10); },
  bell: function () { bell(); },
  autoReport: function () { autoReport(true); },
  send: function (key, what, value) {
    if (MOVED[key] && !findTab(key)) { var mv = MOVED[key]; key = mv[0]; what = mv[1]; value = mv[2]; }   // e.g. "find" opens Folder Check > Find drawings
    show(key);
    var tries = 0, f = frames[key];
    (function go() {
      try { var w = f.contentWindow; if (w && w.ltReceive && w.document.readyState == "complete") { w.ltReceive(what, value); return; } } catch (x) { }
      if (++tries < 40) window.setTimeout(go, 150);
    })();
  },
  /* hands a tab a message WITHOUT switching to it (only if that tab is open; tabs also re-read their files when shown) */
  post: function (key, what, value) { try { var f = frames[key], w = f && f.contentWindow; if (w && w.ltReceive && w.document.readyState == "complete") w.ltReceive(what, value); } catch (x) { } },
  /* after Settings changes the theme or text size: every tab redraws in the new look */
  themeChanged: function (from) {
    look();
    for (var k in frames) if (frames.hasOwnProperty(k)) { try { var w = frames[k].contentWindow; if (w && w !== from && w.ltTheme) w.ltTheme(); } catch (x) { } }
  },
  dataChanged: function () {
    dataHereWarning(); try { topBar(); } catch (e) { }
    for (var k in frames) if (frames.hasOwnProperty(k)) { try { var w = frames[k].contentWindow; if (w && w.ltReload) w.ltReload(); } catch (x) { } }
  },
  makeShortcut: function () { return taskbarShortcut(); },
  search: function () { openSearch(); },
  project: function () { return curProject(); },
  logOut: function (json) { try { logOut(JSON.parse(json)); } catch (e) { } },
  toggleRail: function () { setRail(!isRail(), true); },
  /* for Settings: every tab with its description */
  tabList: function () { var o = []; for (var i = 0; i < tabs.length; i++) o.push({ key: tabs[i].key, title: tabs[i].title, icon: tabs[i].icon, desc: tabs[i].desc }); return o; },
  remindNow: function () { return reminders(true); },
  whatsNew: function () { return whatsNew(true); },
  tipsChanged: function () { tipsOn = LT.settings().tips !== false; hideTip(); renderNav(); },
  appDir: APP
};

function look() {
  var rules = [
    "#nav{background:{side};color:{sideText};border-right:1px solid {sideLine}}#brand{color:{sideHi}}#brand .logo{background:{accent};color:#fff}",
    ".nb{background:transparent;color:{sideText}}.nb:hover{background:{sideHover};color:{sideHi}}.nb.on{background:{accent};color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.35)}",
    "#railBtn{background:transparent;color:{sideMuted};border:1px solid {sideHover}}#railBtn:hover{color:{sideHi};background:{sideHover}}",
    ".ng{color:{sideMuted}}",
    "#top{background:{panel};border-bottom:1px solid {line}}#proj{color:{text}}#proj:hover{background:{hover}}#proj small{color:{muted}}#proj svg{color:{accent}}",
    "#sbox{background:{bg};border:1px solid {line};color:{muted}}#sbox:hover{border-color:{accent}}#sbox kbd{background:{panel};border:1px solid {line};color:{muted}}",
    ".tb{color:{muted}}.tb:hover{background:{hover};color:{text}}.tb.glow{color:{accent};background:{accSoft};box-shadow:0 0 0 3px {accSoft}}#bellN{background:{bad};color:#fff}#me{background:{accSoft};color:{accent}}#clock{color:{muted}}#clkT{color:{text}}",
    "#pm{background:{panel};color:{text};border:1px solid {line};border-radius:12px;box-shadow:{big}}#pm .pi:hover{background:{hover}}#pm .pi.on{background:{accSoft};color:{accent};font-weight:600}#pm .pi small{color:{muted}}#pm .sep{background:{line}}#pm .ph{color:{muted}}",
    "#loBox{background:{panel};color:{text};border:1px solid {line};border-radius:14px;box-shadow:{big}}#loList{border:1px solid {line};border-radius:{r}px;background:{bg}}.pk{border:1px solid {line};border-radius:{r}px}.pk.on{border-color:{accent};background:{accSoft}}#loBox .acts button{background:{bg};color:{text};border:1px solid {line};border-radius:{r}px}#loBox .acts .pri{background:{accent};color:{accText};border-color:{accent}}#loBox .mut{color:{muted};font-size:.85em}",
    "#wnBox{background:{panel};color:{text};border:1px solid {line};border-radius:14px;box-shadow:{big}}#wnBox .v{color:{muted}}",
    "#qsBox{background:{panel};border:1px solid {line};border-radius:14px;box-shadow:{big}}#qsHint{color:{muted}}",
    ".qr{border-radius:{r}px;color:{text}}.qr.on{background:{accSoft};box-shadow:inset 3px 0 0 {accent}}.qr .k{color:{muted}}.qr .s{color:{muted}}",
    "#remind{background:{panel};color:{text};border:1px solid {line};border-radius:14px;box-shadow:{big}}#remind .rb{background:{bg};color:{text};border:1px solid {line};border-radius:{r}px}#remind .rb:hover{border-color:{accent}}#remind .late{color:{bad};font-weight:600}#remind .rx{color:{muted}}",
    "#tip{background:{panel};color:{text};border:1px solid {line};border-radius:12px;box-shadow:{big}}#tip .k{margin-top:6px;font-size:.85em;color:{muted}}"
  ];
  rules.push("#pill{display:block;background:{pill};box-shadow:0 6px 18px rgba(0,0,0,.18)}.nb.on,.nb.on:hover{background:transparent!important;color:{pillText}!important;box-shadow:none!important}",
    ".nbadge{background:{chip};color:{muted}}.nb.on .nbadge{background:{accent};color:#16120a}.nbadge.hot{background:{accent};color:#16120a}",
    "#clock{background:{panel};border:1px solid {line};color:{muted}}#clock .cdot{background:{accent};box-shadow:0 0 0 3px {accSoft}}",
    "#newB{background:{panel};border:1px solid {line};color:{text}}#newB:hover{border-color:{accent}}#newB svg{color:{accent}}",
    "#tsw{background:{panel};border:1px solid {line}}#tsw span{color:{muted}}#tsw span.on{background:{pill};color:{pillText}}",
    "#meBox{background:{panel};border:1px solid {line}}#meBox:hover{border-color:{accent}}#meBox small{color:{muted}}");
  var v = LT.themeVars();
  if (v.ember) rules.push("body{background:{outer}}#nav{border:1px solid {line}}#top{background:transparent;border-bottom:0}#me{background:{grad};color:#16120a}#brand .logo{background:{grad};color:#16120a}",
    "#sbox{background:{panel};border-radius:99px}#proj{border-radius:99px}#proj:hover{background:{panel}}.tb{border-radius:99px}.tb:hover{background:{panel}}");
  if (v.glass) rules.push("body{background-color:{outer};background-image:{glassBg}}",
    "#nav{background:{cardImg};border:1px solid {line};box-shadow:{shadow},{rim}}#body{border:1px solid {line};box-shadow:inset 0 1px 0 {hi},0 18px 44px rgba(0,0,0,.28)}",
    "#sbox,#proj:hover,#clock,#newB,#tsw,#meBox,#bellB{box-shadow:inset 0 1px 0 {hi}}#sbox,#clock,#newB,#tsw,#meBox{background-image:{cardImg}}",
    "#pill{box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 6px 20px rgba(255,90,31,.2);border:1px solid {line}}.nbadge.hot,.nb.on .nbadge{color:#fff}#me,#brand .logo{color:#fff}",
    "#remind,#pm,#qsBox,#wnBox,#loBox,#tip{background:{solid};border:1px solid {line}}#remind .rb,#pm .pi:hover{background:{hover}}");
  LT.applyLook(rules);
  LT.$("shell").className = (isRail() ? "rail" : "") + (v.ember ? " float" : "");
  topBar(); window.setTimeout(function () { movePill(false); }, 50);
}
/* while the data folder is inside the program folder, replacing the program could delete it: say so (once per start) */
function dataHereWarning() {
  var s = LT.settings(), w = LT.$("dataWarn"); if (s.dataFolder || s.dataHereOk) { w.style.display = "none"; return; }
  w.innerHTML = '<div class="dwT" title="Your tasks, lists and logs are saved inside the program folder (' + LT.esc(LT.dataDir()) + '). If you replace or delete that folder when you update the Toolbox, they go with it.">&#9888;<span class="tx"> Your data is inside the program folder &ndash; updating could delete it</span></div>' +
    '<div class="tx"><button class="wb" id="wMove">Move it (Settings)</button><button class="wb" id="wKeep" title="Don\'t ask again">Keep it here</button></div>';
  w.style.display = "block";
  LT.$("wMove").onclick = function () { show("settings"); };
  LT.$("wKeep").onclick = function () { w.style.display = "none"; var s2 = LT.settings(); s2.dataHereOk = true; LT.saveSettings(s2); };
}
/* fold the side menu down to icons (remembered in settings) */
function setRail(on, keep) {
  LT.$("shell").className = (on ? "rail" : "") + (LT.themeVars().ember ? " float" : ""); window.setTimeout(function () { movePill(false); }, 280);
  LT.$("railBtn").innerHTML = on ? "&#8250;" : "&#8249;";
  LT.$("railBtn").title = on ? "Open the menu (Ctrl+[)" : "Fold the menu to icons (Ctrl+[)";
  if (keep) { var s = LT.settings(); s.rail = !!on; LT.saveSettings(s); }
}

/* the hover tip beside the side menu: what each tab is for (Settings > Hover tips) */
function showTip(b) {
  if (!tipsOn) return;
  var t = null, k = b.getAttribute("data-k"); for (var i = 0; i < tabs.length; i++) if (tabs[i].key == k) t = tabs[i];
  if (!t || !t.desc) return;
  var r = b.getBoundingClientRect(), tip = LT.$("tip");
  tip.innerHTML = "<b>" + t.icon + " " + LT.esc(t.title) + "</b>" + t.desc + (tabs.indexOf(t) < 9 ? '<div class="k">Ctrl+' + (tabs.indexOf(t) + 1) + "</div>" : "");
  tip.style.display = "block";
  tip.style.left = (r.right + 8) + "px";
  tip.style.top = Math.max(4, Math.min(r.top, document.documentElement.clientHeight - tip.offsetHeight - 6)) + "px";
}
function hideTip() { LT.$("tip").style.display = "none"; }
function clock() {
  var d = new Date();
  LT.$("clkT").innerHTML = LT.pad(d.getHours()) + ":" + LT.pad(d.getMinutes());
  LT.$("clkD").innerHTML = LT.DAYS[d.getDay()] + " " + d.getDate() + " " + LT.MON[d.getMonth()];
}

/* ---------- Ctrl+K: search everything (tasks, delegated work, transmittals, drawings, people, task-folder files, tabs) ---------- */
var qsAll = [], qsHits = [], qsOn = 0;
function qsIndex() {
  var o = [], J = function (n) { return LT.readJson(LT.dataPath(n), null) || {}; }, i, j;
  var add = function (kind, code, title, sub, go) { o.push({ kind: kind, code: code || "", title: title || "", sub: sub || "", go: go, hay: (code + " " + title + " " + sub).toLowerCase() }); };
  var tr = J("tracker.json").tasks || [];
  for (i = 0; i < tr.length; i++) (function (t) {
    add("Task", t.code, t.title, [t.who, t.project, t.status == "Done" ? "done" : t.due ? "due " + LT.fmtDate(t.due) : ""].join("  ").replace(/^\s+/, ""), function () { LTMain.send("tracker", "show-task", t.code); });
    for (j = 0; j < (t.subs || []).length; j++) add("Task item", t.subs[j].code, t.subs[j].title, (t.subs[j].who || "") + "  in " + t.code + " " + t.title, function () { LTMain.send("tracker", "show-task", t.code); });
    if (t.folder) { try { var fs = LT.tfFiles(t.folder); for (var f = 0; f < fs.length; f++) (function (x) { add("File", "", x.name, t.code + " \\ " + x.sub, function () { try { LT.open(x.path); } catch (e) { } }); })(fs[f]); } catch (e) { } }
  })(tr[i]);
  var dg = J("delegate.json"), dt = dg.tasks || [], ppl = {};
  for (i = 0; i < dt.length; i++) (function (t) {
    add("Delegated", t.code, t.title, (t.who || "") + (t.due ? "  due " + LT.fmtDate(t.due) : ""), function () { LTMain.send("delegate", "show-task", t.code); });
    for (j = 0; j < (t.subs || []).length; j++) add("Delegated item", t.subs[j].code, t.subs[j].title, (t.subs[j].who || "") + "  in " + t.code, function () { LTMain.send("delegate", "show-task", t.code); });
    var ws = ("" + (t.who || "")).split(/\s*[,;&\/]\s*/); for (j = 0; j < (t.subs || []).length; j++) ws.push(t.subs[j].who || ""); for (j = 0; j < ws.length; j++) if (LT.trim(ws[j])) ppl[LT.trim(ws[j])] = 1;
  })(dt[i]);
  var gs = dg.groups || [];
  for (i = 0; i < gs.length; i++) { ppl[gs[i].lead] = 1; for (j = 0; j < (gs[i].members || []).length; j++) ppl[gs[i].members[j]] = 1; (function (g) { add("Group", "", g.name, "lead " + g.lead + "  \u00b7  " + (g.members || []).join(", "), function () { LTMain.send("delegate", "person", g.name); }); })(gs[i]); }
  for (var p in ppl) if (ppl.hasOwnProperty(p) && p) (function (n) { add("Person", "", n, "their delegated work", function () { LTMain.send("delegate", "person", n); }); })(p);
  var tl = J("transmittals.json").log || [];
  for (i = 0; i < tl.length; i++) (function (t) { var its = []; for (j = 0; j < (t.items || []).length; j++) its.push((t.items[j].number || "") + " " + (t.items[j].rev || "") + " " + (t.items[j].title || ""));
    add("Transmittal", t.no, "to " + (t.to || "?"), LT.fmtDate(t.date) + "  " + its.join("  ").substring(0, 300), function () { if (t.dir && fso.FolderExists(t.dir)) LT.open(t.dir); else show("transmittal"); }); })(tl[i]);
  try { var R = LT.register(); if (R) { var ds = R.list(); for (i = 0; i < ds.length; i++) (function (d) { add("Drawing", d.number, d.title, [d.cat, d.tower].join("  "), function () { LTMain.send("register", "find", d.number); }); })(ds[i]); } } catch (e) { }
  for (i = 0; i < tabs.length; i++) (function (t) { add("Tab", "", t.title, "", function () { show(t.key); }); })(tabs[i]);
  return o;
}
function openSearch() { qsAll = qsIndex(); LT.$("qs").style.display = "block"; var i = LT.$("qsIn"); i.value = ""; qsFind(); try { i.focus(); } catch (e) { } }
function closeSearch() { LT.$("qs").style.display = "none"; }
function qsFind() {
  var w = LT.trim(LT.$("qsIn").value.toLowerCase()).split(/\s+/); qsHits = []; qsOn = 0;
  if (w[0]) for (var i = 0; i < qsAll.length && qsHits.length < 60; i++) { var x = qsAll[i], ok = true; for (var k = 0; k < w.length; k++) if (x.hay.indexOf(w[k]) < 0) { ok = false; break; } if (ok) qsHits.push(x); }
  var q = w.join(" ");
  qsHits.sort(function (a, b) { var s = function (x) { return x.code.toLowerCase() == q ? 0 : x.title.toLowerCase().indexOf(q) == 0 || x.code.toLowerCase().indexOf(q) == 0 ? 1 : 2; }; return s(a) - s(b); });
  var h = ""; for (var j = 0; j < qsHits.length; j++) { var y = qsHits[j]; h += '<div class="qr' + (j == qsOn ? " on" : "") + '" data-q="' + j + '"><span class="k">' + LT.esc(y.kind) + "</span>" + (y.code ? '<span class="c">' + LT.esc(y.code) + "</span>" : "") + LT.esc(y.title) + (y.sub ? '<span class="s">' + LT.esc(y.sub) + "</span>" : "") + "</div>"; }
  LT.$("qsRes").innerHTML = h || (w[0] ? '<div class="qr">Nothing found for "' + LT.esc(q) + '"</div>' : '<div class="qr" style="cursor:default">Type a task, drawing number, transmittal (TR-005), a name or a file name.</div>');
}
function qsMark() { var rs = LT.$("qsRes").childNodes; for (var i = 0; i < rs.length; i++) rs[i].className = "qr" + (i == qsOn ? " on" : ""); try { rs[qsOn].scrollIntoView(false); } catch (e) { } }
function qsGo(i) { var x = qsHits[i]; if (!x) return; closeSearch(); x.go(); }

/* ---------- "Log this to Transmittal?" after an export: what goes out (all or some), to whom, and how it's packed ---------- */
var LO = null;
function logOut(o) {
  LO = o; o.items = o.items || [];
  if (o.file) { var fn = fso.GetFileName(o.file), dt = fn.lastIndexOf("."); o.items.push({ number: dt > 0 ? fn.substring(0, dt) : fn, title: o.fileTitle || o.source || "Exported list", rev: "", types: dt > 0 ? fn.substring(dt + 1).toLowerCase() : "", files: [o.file], isFile: true }); }
  var s = LT.trLoad(), seen = {}, to = "", h = "";
  for (var i = s.log.length - 1; i >= 0; i--) { var t = s.log[i].to; if (t && !seen[t]) { seen[t] = 1; to += '<option value="' + LT.esc(t) + '">'; } }
  var nf = 0; for (var j = 0; j < o.items.length; j++) nf += (o.items[j].files || []).length;
  h += "<h3>&#128232; Log this to Transmittal?</h3><div class=\"mut\">" + LT.esc(o.source || "Export") + " &middot; " + o.items.length + " item(s)" + (nf ? " &middot; " + nf + " file(s)" : "") + " &middot; next number <b>" + LT.esc(LT.trNo(s)) + "</b></div>";
  h += '<div style="margin-top:8px"><b>What goes out</b> <span class="mut">(untick what stays)</span> <a href="#" id="loAll">all</a> &middot; <a href="#" id="loNone">none</a></div><div id="loList">';
  for (var k = 0; k < o.items.length; k++) { var it = o.items[k]; h += '<label title="' + LT.esc((it.files || []).join("\n")) + '"><input type="checkbox" data-lo="' + k + '" checked style="height:auto"> <b>' + LT.esc(it.number) + "</b>" + (it.rev ? " " + LT.esc(it.rev) : "") + (it.title ? ' <span class="mut">' + LT.esc(it.title) + "</span>" : "") + (it.types ? ' <span class="mut">(' + LT.esc(it.types) + ")</span>" : "") + "</label>"; }
  h += '</div><div class="lf"><label>To (company)</label><input type="text" id="loTo" list="loToL" value="' + LT.esc(o.to || "") + '"><datalist id="loToL">' + to + '</datalist></div><div class="lf"><label>Attention</label><input type="text" id="loAttn"></div>' +
    '<div class="lf"><label>Purpose</label><select id="loPurp"><option>For information</option><option>For checking</option><option>For action</option><option>For comment</option><option>For review and approval</option><option>For coordination</option><option>For construction</option></select></div>' +
    '<div class="lf" style="width:100%"><label>Notes</label><input type="text" id="loNotes" style="width:98%" value="' + LT.esc(o.notes || "") + '"></div>' +
    '<div style="margin-top:4px"><b>How it goes out</b></div>' +
    '<label class="pk on" data-pk="log"><input type="radio" name="loPk" value="log" checked style="height:auto"><b>&#128221; Log only</b><small>The transmittal sheet + the log. The files stay where they are (already on the shared drive / ACC) &ndash; nothing is copied.</small></label>' +
    '<label class="pk" data-pk="zip"><input type="radio" name="loPk" value="zip" style="height:auto"><b>&#128230; One zip to send</b><small>TR-xxx.zip with the sheet and each file once, made straight from where they are &ndash; no copies left in the folder, nothing doubled.</small></label>' +
    '<label class="pk" data-pk="folder"><input type="radio" name="loPk" value="folder" style="height:auto"><b>&#128193; Transmittal folder</b><small>The sheet + a copy of each file in the TR folder (to upload the folder as it is).</small></label>' +
    '<div class="acts"><span class="mut" style="float:left;margin-top:8px"><a href="#" id="loOff">Don\'t ask for &quot;' + LT.esc(o.source || "this") + '&quot;</a></span><button id="loNo">Not this time</button><button class="pri" id="loYes">Log it</button></div>';
  LT.$("loBox").innerHTML = h; LT.$("lo").style.display = "block";
  var lst = LT.$("loList").getElementsByTagName("input"), tick = function (v) { for (var q = 0; q < lst.length; q++) lst[q].checked = v; return false; };
  LT.$("loAll").onclick = function () { return tick(true); }; LT.$("loNone").onclick = function () { return tick(false); };
  var pks = LT.$("loBox").getElementsByTagName("label");
  LT.$("loBox").onclick = function (e) { var p = LT.up(e ? e.target : window.event.srcElement, "data-pk"); if (!p) return; for (var z = 0; z < pks.length; z++) if (pks[z].getAttribute("data-pk")) pks[z].className = "pk" + (pks[z] === p ? " on" : ""); p.getElementsByTagName("input")[0].checked = true; };
  LT.$("loNo").onclick = function () { LT.$("lo").style.display = "none"; LO = null; };
  LT.$("loOff").onclick = function () { var s2 = LT.settings(); s2.askLogOff = s2.askLogOff || {}; s2.askLogOff[o.source] = true; LT.saveSettings(s2); LT.$("lo").style.display = "none"; LT.toast("Won't ask again for " + o.source + " (Settings can turn it back on)"); return false; };
  LT.$("loYes").onclick = function () {
    var items = [], pk = "log", rs = document.getElementsByName("loPk"); for (var r = 0; r < rs.length; r++) if (rs[r].checked) pk = rs[r].value;
    for (var q = 0; q < lst.length; q++) if (lst[q].checked) { var x = o.items[+lst[q].getAttribute("data-lo")]; items.push({ number: x.number, title: x.title || "", rev: x.rev || "", types: x.types || "", files: x.files || [] }); }
    if (!items.length) { alert("Tick at least one item."); return; }
    var t = { project: o.project || "", to: LT.trim(LT.$("loTo").value), attn: LT.trim(LT.$("loAttn").value), purpose: LT.$("loPurp").value, notes: LT.trim(LT.$("loNotes").value), items: items, source: o.source || "" };
    var res; try { res = LT.trMake(t, { copy: pk == "folder", zip: pk == "zip" }); } catch (e) { alert("Couldn't make the transmittal:\n" + (e.message || e)); return; }
    LT.$("lo").style.display = "none"; LO = null;
    LT.toast(res.no + " logged" + (pk == "zip" ? " - zip ready" : pk == "folder" ? " - " + res.copied + " file(s) copied" : ""));
    if (res.errors.length) alert(res.no + ":\n" + res.errors.slice(0, 10).join("\n"));
    try { LT.showInFolder(res.zip || res.dir); } catch (e) { }
    LTMain.post("transmittal", "reload", "");
  };
}

/* ---------- "What's new": once after an update (Settings can show it again) ---------- */
function whatsNew(force) {
  var s = LT.settings(), seen = s.seenVersion || "", h = "";
  if (!force && seen == LT.VERSION) return false;
  for (var i = 0; i < LT.WHATS_NEW.length; i++) { var w = LT.WHATS_NEW[i]; if (!force && seen && w.v <= seen) continue; if (!force && !seen && i > 0) break;
    h += '<div class="v">Version ' + LT.esc(w.v) + "</div><ul><li>" + w.items.join("</li><li>") + "</li></ul>"; }
  if (!h) { s.seenVersion = LT.VERSION; LT.saveSettings(s); return false; }
  LT.$("wnBox").innerHTML = "<h3>&#10024; What's new in Lew's Toolbox</h3>" + h + '<button class="btn primary" id="wnOk">Got it</button> <span class="v">Your tasks and lists are kept as they were.</span>';
  LT.$("wn").style.display = "block";
  LT.$("wnOk").onclick = function () { LT.$("wn").style.display = "none"; var s2 = LT.settings(); s2.seenVersion = LT.VERSION; LT.saveSettings(s2); };
  return true;
}

/* ---------- once a day, on opening: what's due today, what's late (yours and your team's) ---------- */
function reminders(force) {
  var s = LT.settings(); if (!force && (s.remind === false || s.remindOn == LT.today())) return false;
  var today = LT.today(), R0 = remindData(), mineToday = R0.mineToday, mineLate = R0.mineLate, team = R0.team, nLate = R0.nLate, i;
  if (!mineToday.length && !mineLate.length && !nLate && !R0.incoming && !R0.report) { if (!force) { s.remindOn = today; LT.saveSettings(s); } return false; }
  var h = '<span class="rx" id="rX" title="Close">&#10005;</span><h4><span> Good ' + (new Date().getHours() < 12 ? "morning" : new Date().getHours() < 17 ? "afternoon" : "evening") + (s.userName ? ", " + LT.esc(s.userName) : "") + "</span></h4><div class=\"tx\"><ul>";
  if (mineToday.length) h += "<li><b>" + mineToday.length + "</b> of your tasks due today</li>";
  if (mineLate.length) h += '<li class="late">' + mineLate.length + " of your tasks late</li>";
  var ppl = []; for (var p in team) if (team.hasOwnProperty(p)) ppl.push(p);
  ppl.sort(function (a, b) { return team[b].length - team[a].length; });
  for (i = 0; i < ppl.length && i < 4; i++) h += '<li class="late">' + LT.esc(ppl[i]) + ": " + team[ppl[i]].length + " late (" + LT.esc(team[ppl[i]].slice(0, 3).join(", ")) + (team[ppl[i]].length > 3 ? "..." : "") + ")</li>";
  if (ppl.length > 4) h += "<li>+ " + (ppl.length - 4) + " more people with late work</li>";
  if (R0.incoming) h += "<li><b>" + R0.incoming + "</b> new / changed file" + (R0.incoming > 1 ? "s" : "") + " in the folders you watch</li>";
  if (R0.report) h += "<li>Your <b>weekly report</b> is ready</li>";
  h += "</ul>" + (mineToday.length || mineLate.length ? '<button class="rb" id="rMine">My tasks</button>' : "") + (R0.incoming ? '<button class="rb" id="rIn">See the new files</button>' : "") + (R0.report ? '<button class="rb" id="rRep">Open the report</button>' : "") + (nLate ? '<button class="rb" id="rChase">&#128276; Chase up (' + nLate + ")</button>" : "") + "</div>";
  var box = LT.$("remind"); box.innerHTML = h; box.style.display = "block";
  var shut = function () { box.style.display = "none"; };
  LT.$("rX").onclick = shut;
  if (LT.$("rMine")) LT.$("rMine").onclick = function () { shut(); LTMain.send("tracker", "view", mineLate.length ? "overdue" : "today"); };
  if (LT.$("rIn")) LT.$("rIn").onclick = function () { shut(); show("home"); };
  if (LT.$("rRep")) LT.$("rRep").onclick = function () { shut(); var s2 = LT.settings(); try { LT.open(s2.reportReady); } catch (e) { } s2.reportReady = ""; LT.saveSettings(s2); bell(); };
  if (LT.$("rChase")) LT.$("rChase").onclick = function () { shut(); LTMain.send("delegate", "chase", ""); };
  if (!force) { s.remindOn = today; LT.saveSettings(s); }
  return true;
}

/* ---------- the top bar: project, search, bell, light / dark, you ---------- */
/* the project = a project of the Drawing Register (register.json); every tab reads it with LT.project() */
function projects() { var ix = LT.registerIndex(); return { list: ix.projects || [], cur: ix.current || "" }; }
function isRail() { return /(^| )rail( |$)/.test(LT.$("shell").className); }
/* the pill behind the menu item you're on slides to the next one: the front edge goes first, the back edge follows */
var pillAt = null;
function movePill(anim) {
  var p = LT.$("pill"), tb = LT.$("tabs"), b = null, bs = tb.getElementsByTagName("button"); for (var i = 0; i < bs.length; i++) if (/(^| )on( |$)/.test(bs[i].className)) b = bs[i];
  if (!b) { p.style.display = "none"; return; } p.style.display = "block";
  var wrap = LT.$("tabsWrap"), top = b.offsetTop - tb.scrollTop + tb.offsetTop, bot = wrap.offsetHeight - top - b.offsetHeight;
  if (anim && pillAt && LT.smooth()) p.style.transition = "top .16s ease-out,bottom .16s ease-out";
  else if (anim && pillAt) { var down = top > pillAt.top, fast = "cubic-bezier(.3,1.4,.5,1)", slow = "cubic-bezier(.65,0,.35,1)";
    p.style.transition = down ? "bottom .34s " + fast + ",top .55s " + slow : "top .34s " + fast + ",bottom .55s " + slow; }
  else p.style.transition = "none";
  p.style.top = top + "px"; p.style.bottom = bot + "px"; pillAt = { top: top };
}
/* small counts next to Tasks and Delegate (yours due / late; the team's late) */
function navBadges() {
  try { if (!REM) REM = remindData(); var n = { tracker: REM.mineToday.length + REM.mineLate.length, delegate: REM.nLate };
    var bs = LT.$("tabs").getElementsByTagName("button"); for (var i = 0; i < bs.length; i++) { var k = bs[i].getAttribute("data-k"), old = bs[i].getElementsByTagName("i"); for (var o = old.length - 1; o >= 0; o--) if (/nbadge/.test(old[o].className)) old[o].parentNode.removeChild(old[o]);
      if (n[k]) { var e = document.createElement("i"); e.className = "nbadge" + (k == "delegate" ? " hot" : ""); e.innerHTML = n[k]; bs[i].appendChild(e); } } } catch (e2) { }
}
function newMenu() {
  var r = LT.$("newB").getBoundingClientRect(), h = '<div class="ph">New</div><div class="pi" data-nw="task">' + LT.icon("taskcheck", 16) + "Task...</div>" + '<div class="pi" data-nw="tpl">' + LT.icon("files", 16) + "Task from a template...</div>" +
    '<div class="pi" data-nw="tr">' + LT.icon("transmittal", 16) + "Issue drawings (wizard)</div>" + '<div class="pi" data-nw="check">' + LT.icon("check", 16) + "Check a submission (Check all)</div>" + '<div class="sep"></div><div class="pi" data-pa="new">' + LT.icon("project", 16) + "Project...</div>";
  var pm = LT.$("pm"); pm.innerHTML = h; pm.style.left = Math.round(Math.max(8, r.right - 330)) + "px"; pm.style.top = Math.round(r.bottom + 6) + "px"; pm.style.display = "block";
}
function curProject() { var p = projects(); for (var i = 0; i < p.list.length; i++) if (p.list[i].id == p.cur) return p.list[i]; return null; }
function topBar() {
  var p = curProject(), s = LT.settings(), n = LT.trim(s.userName || ""), ini = "";
  LT.$("proj").innerHTML = LT.icon("project", 20) + '<span class="pl"><small>Project</small><b>' + LT.esc(p ? p.name : "No project yet") + "</b></span>" + LT.icon("chev", 14);
  LT.$("sbox").innerHTML = LT.icon("search", 17) + "<span>Search tasks, drawings, transmittals, people...</span><kbd>Ctrl K</kbd>";
  LT.$("themeB").innerHTML = LT.icon(/dark|slate$|blueprint|retro/.test(s.theme || "") ? "sun" : "moon", 19);
  var dark = /dark|^ember$|^glass$|slate$|blueprint|retro|console/.test(s.theme || "ember") && s.theme != "emberlight";
  LT.$("newB").innerHTML = LT.icon("plus", 16) + "New"; LT.$("tsL").innerHTML = LT.icon("sun", 16); LT.$("tsD").innerHTML = LT.icon("moon", 16); LT.$("tsL").className = dark ? "" : "on"; LT.$("tsD").className = dark ? "on" : "";
  LT.$("meN").innerHTML = LT.esc(n || "You"); LT.$("meR").innerHTML = LT.esc(s.role || "Settings");
  var ps = n.split(/[\s._]+/); for (var i = 0; i < ps.length && ini.length < 2; i++) if (ps[i]) ini += ps[i].charAt(0).toUpperCase(); LT.$("me").innerHTML = LT.esc(ini || "ME"); LT.$("me").title = (n || "You") + " - Settings";
  bell();
}
function projMenu() {
  var P = projects(), r = LT.$("proj").getBoundingClientRect(), h = '<div class="ph">Projects</div>';
  for (var i = 0; i < P.list.length; i++) { var pr = P.list[i], n = 0; try { var j = LT.readJson(LT.registerFile(pr.id), null); if (j && j.drawings) for (var k in j.drawings) if (j.drawings.hasOwnProperty(k) && j.drawings[k].inMidp !== false) n++; } catch (e) { }
    h += '<div class="pi' + (pr.id == P.cur ? " on" : "") + '" data-pj="' + LT.esc(pr.id) + '">' + LT.icon(pr.id == P.cur ? "ok" : "project", 16) + LT.esc(pr.name) + "<small>" + n + " drawings</small></div>"; }
  if (!P.list.length) h += '<div class="pi" style="cursor:default"><span class="muted">No project yet</span></div>';
  h += '<div class="sep"></div><div class="pi" data-pa="new">' + LT.icon("plus", 16) + "New project...</div>" + (P.cur ? '<div class="pi" data-pa="setup">' + LT.icon("settings", 16) + "Project setup (MIDP, models, ACC)...</div>" : "");
  var pm = LT.$("pm"); pm.innerHTML = h; pm.style.left = Math.round(r.left) + "px"; pm.style.top = Math.round(r.bottom + 6) + "px"; pm.style.display = "block";
}
function pickProject(id) {
  var ix = LT.registerIndex(); if (ix.current == id) return; ix.current = id; try { LT.saveJson(LT.dataPath("register.json"), ix); } catch (e) { }
  var p = curProject(); LT.toast("Project: " + (p ? p.name : "")); topBar(); LTMain.dataChanged();
}
/* the bell: how many things need you today (yours due / late + the team's late work) */
var REM = null;
function remindData() {
  var s = LT.settings(), today = LT.today(), o = { mineToday: [], mineLate: [], team: {}, nLate: 0 }, i, j;
  var tr = (LT.readJson(LT.dataPath("tracker.json"), null) || {}).tasks || [];
  for (i = 0; i < tr.length; i++) { var t = tr[i]; if (t.status == "Done" || !t.due || t.delegated) continue; if (t.due == today) o.mineToday.push(t); else if (t.due < today) o.mineLate.push(t); }
  var dj = LT.readJson(LT.dataPath("delegate.json"), null) || {}, dt = dj.tasks || [], lead = {};
  if (s.chaseLead !== false) for (i = 0; i < (dj.groups || []).length; i++) lead[LT.trim(dj.groups[i].name).toLowerCase()] = dj.groups[i].lead;   // a group's work: its lead answers for it
  var lateFor = function (who, code) { who = LT.trim(who || "") || "?"; o.team[who] = o.team[who] || []; o.team[who].push(code); o.nLate++; };
  for (i = 0; i < dt.length; i++) { var d = dt[i], subs = d.subs || [], gl = lead[LT.trim(d.who || "").toLowerCase()];
    if (subs.length) { for (j = 0; j < subs.length; j++) { var du = subs[j].due || d.due; if (subs[j].status != "Completed" && du && du < today) lateFor(gl || subs[j].who || d.who, subs[j].code); } }
    else if (d.status != "Completed" && d.due && d.due < today) lateFor(d.who, d.code); }
  try { o.incoming = LT.watchPending(); } catch (e) { o.incoming = 0; } o.report = s.reportReady && fso.FileExists(s.reportReady) ? s.reportReady : "";
  return o;
}
/* ---------- in the background (every 10 minutes): watched folders, the automatic weekly report ---------- */
function background(tries) {
  /* if you're clicking / scrolling / typing, wait a few seconds (up to ~40 s): a folder check can take a moment and would make the window stutter */
  tries = tries || 0; var idle = new Date().getTime() - (window.__act || 0);
  if (idle < 3000 && tries < 10) { window.setTimeout(function () { background(tries + 1); }, 4000); return; }
  var before = 0, W = null; try { before = LT.watchPending(); W = LT.watchLoad(); } catch (e0) { W = { folders: [] }; }
  var k = 0, step = function () {
    if (k < W.folders.length) { try { LT.watchScan(k); } catch (e1) { } k++; window.setTimeout(step, 80); return; }   // a folder at a time, a breath between
    try { var n = LT.watchPending(), mt = LT.watchMatch();
      if (n > before) { LT.$("bellB").className = "tb glow"; LT.toast((n - before) + " new / changed file" + (n - before > 1 ? "s" : "") + " in the folders you watch"); }
      if (mt.length) { LT.toast("Output received: " + mt.slice(0, 3).map(function (x) { return x.code; }).join(", ") + (mt.length > 3 ? "..." : "") + " (Delegate)"); try { frames.delegate.contentWindow.ltReload(); } catch (e) { } }
      if (n != before || mt.length) try { frames.home.contentWindow.ltReload(); } catch (e) { } } catch (e2) { }
    try { autoReport(); } catch (e3) { }
    bell(); };
  step();
}
/* the weekly report makes itself (Settings): on the chosen day or later in the week, once a week, into exports\Weekly reports */
function autoReport(force) {
  var s = LT.settings(); if (!s.autoReport && !force) return;
  var d = new Date(), dow = d.getDay() || 7, day = +(s.autoReportDay || 5), ws = new Date(d.getFullYear(), d.getMonth(), d.getDate() - dow + 1), wk = LT.iso(ws);
  if (!force && (dow < day || s.lastAutoReport == wk)) return;
  var f = document.createElement("iframe"); f.setAttribute("application", "yes"); f.style.display = "none"; f.src = "tabs/parts/report.html";
  f.onload = function () { var p = null; try { p = f.contentWindow.ltAuto(); } catch (e) { } window.setTimeout(function () { try { f.parentNode.removeChild(f); } catch (e) { } }, 0);
    if (!p) return; var s2 = LT.settings(); s2.lastAutoReport = wk; s2.reportReady = p; LT.saveSettings(s2); LT.$("bellB").className = "tb glow"; LT.toast("Your weekly report is ready (bell)"); bell(); try { frames.home.contentWindow.ltReload(); } catch (e) { } };
  document.body.appendChild(f);
}
function bell() { try { window.setTimeout(navBadges, 0); REM = remindData(); var n = REM.mineToday.length + REM.mineLate.length + REM.nLate + REM.incoming + (REM.report ? 1 : 0), b = LT.$("bellN"); LT.$("bellB").innerHTML = LT.icon("bell", 19) + '<span id="bellN"></span>'; b = LT.$("bellN"); b.innerHTML = n > 99 ? "99+" : "" + n; b.style.display = n ? "block" : "none"; } catch (e) { } }

/* ---------- window size + icon (same tricks as QuickLaunch) ---------- */
function sizeWindow() {
  try {
    var s = LT.settings(), w = s.win ? s.win.w : 1180, h = s.win ? s.win.h : 720;
    w = Math.min(Math.max(w, 520), screen.availWidth); h = Math.min(Math.max(h, 360), screen.availHeight);
    window.resizeTo(w, h);
    var dw = w - document.documentElement.clientWidth, dh = h - document.documentElement.clientHeight;
    if (dw > 0 || dh > 0) window.resizeTo(w + dw, h + dh);
    if (!s.win) window.moveTo(Math.max(0, (screen.availWidth - w - dw) / 2), Math.max(0, (screen.availHeight - h - dh) / 2));
  } catch (e) { }
}
/* Windows only finds the window/taskbar icon if the HTA points to it with a FULL path */
function fixHtaIcon() {
  try {
    var ico = APP + "\\LewsToolbox.ico"; if (!fso.FileExists(ico) || !/\.hta$/i.test(SELF)) return;
    var f = fso.OpenTextFile(SELF, 1, false, 0), t = f.ReadAll(); f.Close();
    var re = /(<hta:application[^>]*?\sicon=")([^"]*)(")/i, m = re.exec(t);
    if (!m || m[2] == ico || t.indexOf("LewsToolbox") < 0) return;
    var nt = t.replace(re, "$1" + ico.replace(/\$/g, "$$$$") + "$3"), tmp = SELF + ".new";
    var w = fso.CreateTextFile(tmp, true, false); w.Write(nt); w.Close();
    fso.CopyFile(tmp, SELF, true); fso.DeleteFile(tmp);
  } catch (e) { }
}
function makeShortcut(where) {
  var ico = APP + "\\LewsToolbox.ico", lnk = where + "\\Lew's Toolbox.lnk";
  var sc = LT.wsh.CreateShortcut(lnk);
  sc.TargetPath = LT.env("%WINDIR%") + "\\System32\\mshta.exe";
  sc.Arguments = '"' + SELF + '"'; sc.WorkingDirectory = APP; sc.Description = "Lew's Toolbox";
  if (fso.FileExists(ico)) sc.IconLocation = ico + ",0";
  sc.Save(); return lnk;
}
function taskbarShortcut() {
  try {
    var lnk = makeShortcut(LT.wsh.SpecialFolders("Desktop")); makeShortcut(APP);
    LT.wsh.Run('explorer.exe /select,"' + lnk + '"', 1, false);
    return lnk;
  } catch (e) { alert("Couldn't make the shortcut:\n" + (e.message || e)); return null; }
}

(function start() {
  /* the new look (Studio) once for everyone; Settings can still pick another */
  (function () { var s = LT.settings(); if (!s.look3) { s.look3 = 1; s.look2 = 1; s.theme = /light|^studio$|gameboy/.test(s.theme || "") && s.theme != "slatelight" ? "emberlight" : "ember"; LT.saveSettings(s); } })();
  look(); sizeWindow(); clock();
  window.setInterval(clock, 15000);
  if (/\\Temp\\|\.zip\\/i.test(APP)) { var w = LT.$("warn"); w.innerHTML = "You're running Lew's Toolbox from inside a zip or temporary folder. Extract the whole folder first, or your work won't be saved."; w.style.display = "block"; }
  try { LT.mkdirs(LT.dataDir()); } catch (e) { var w2 = LT.$("warn"); w2.innerHTML = "Can't save in the data folder: " + LT.esc(LT.dataDir()) + " - pick another one in Settings."; w2.style.display = "block"; }
  tabs = findTabs(); tipsOn = LT.settings().tips !== false;
  window.setTimeout(function () { try { LT.dailyBackup(); } catch (e) { } }, 1500);   // once a day: a copy of the data folder in Backups\<date>
  window.setTimeout(background, 5000); window.setInterval(background, 10 * 60000);   // every 10 minutes: watched folders, the weekly report
  dataHereWarning();
  LT.$("tabs").onmouseover = function (e) { var b = LT.up(e.target || e.srcElement, "data-k"); if (b) showTip(b); else hideTip(); };
  LT.$("tabs").onmouseout = function (e) { var to = e.relatedTarget || e.toElement; if (!to || !LT.up(to, "data-k")) hideTip(); };
  LT.$("tabs").onclick = function (e) { var b = LT.up(e.target || e.srcElement, "data-k"); if (b) { hideTip(); show(b.getAttribute("data-k")); } };
  document.onkeydown = function (e) { e = e || window.event;
    if (LT.$("qs").style.display == "block") { if (e.keyCode == 27) { closeSearch(); return false; } if (e.keyCode == 40 || e.keyCode == 38) { qsOn = Math.max(0, Math.min(qsHits.length - 1, qsOn + (e.keyCode == 40 ? 1 : -1))); qsMark(); return false; } if (e.keyCode == 13) { qsGo(qsOn); return false; } }
    if (e.ctrlKey && e.keyCode == 75) { openSearch(); return false; }
    if (e.ctrlKey && e.keyCode >= 49 && e.keyCode <= 57) { LTMain.showIndex(e.keyCode - 49); return false; } if (e.ctrlKey && e.keyCode == 219) { setRail(!isRail(), true); return false; } };
  LT.$("railBtn").onclick = function (e) { setRail(!isRail(), true); (e || window.event).cancelBubble = true; };
  if (LT.settings().rail) setRail(true, false);
  LT.$("proj").onclick = function (e) { if (LT.$("pm").style.display == "block") { LT.$("pm").style.display = "none"; return; } projMenu(); (e || window.event).cancelBubble = true; };
  LT.$("pm").onclick = function (e) { var t = e ? e.target : window.event.srcElement, pj = LT.up(t, "data-pj"), pa = LT.up(t, "data-pa"); LT.$("pm").style.display = "none";
    var nw = LT.up(t, "data-nw"); if (nw) { var w = nw.getAttribute("data-nw"); if (w == "task") LTMain.send("tracker", "new-task", ""); else if (w == "tpl") LTMain.send("tracker", "templates", ""); else if (w == "tr") LTMain.send("transmittal", "view", "wiz"); else if (w == "check") LTMain.send("check", "view", "checkall"); return; }
    if (pj) pickProject(pj.getAttribute("data-pj")); else if (pa) LTMain.send("register", pa.getAttribute("data-pa") == "new" ? "new-project" : "setup", ""); };
  document.onmousedown = function (e) { var t = e ? e.target : window.event.srcElement;
    if (!(function (x) { while (x) { if (x.id == "remind" || x.id == "bellB") return true; x = x.parentNode; } return false; })(t)) LT.$("remind").style.display = "none"; if (!LT.up(t, "data-pm") && t.id != "pm" && !(function (x) { while (x) { if (x.id == "pm" || x.id == "proj" || x.id == "newB") return true; x = x.parentNode; } return false; })(t)) LT.$("pm").style.display = "none"; };
  LT.$("sbox").onclick = function () { openSearch(); };
  LT.$("tabs").onscroll = function () { movePill(false); };
  LT.$("newB").onclick = function (e) { if (LT.$("pm").style.display == "block") { LT.$("pm").style.display = "none"; return; } newMenu(); (e || window.event).cancelBubble = true; };
  var themeTo = function (dark) { var s = LT.settings(), cur = s.theme || "ember", fam = /^studio/.test(cur) ? "studio" : /^glass/.test(cur) ? "glass" : "ember"; s.theme = fam == "studio" ? (dark ? "studiodark" : "studio") : fam == "glass" ? (dark ? "glass" : "glasslight") : (dark ? "ember" : "emberlight"); LT.saveSettings(s); LTMain.themeChanged(); };
  LT.$("tsL").onclick = function () { themeTo(false); }; LT.$("tsD").onclick = function () { themeTo(true); };
  LT.$("meBox").onclick = function () { show("settings"); };
  LT.$("bellB").onclick = function () { this.className = "tb"; if (LT.$("remind").style.display == "block") { LT.$("remind").style.display = "none"; return; } if (!reminders(true)) LT.toast("All clear - nothing due today, nothing late"); };
  LT.$("themeB").onclick = function () { var s = LT.settings(); s.theme = s.theme == "studiodark" ? "studio" : s.theme == "studio" || !s.theme ? "studiodark" : /dark|slate$|blueprint|retro|console/.test(s.theme) ? "studio" : "studiodark"; LT.saveSettings(s); LTMain.themeChanged(); };

  LT.$("qsIn").onkeyup = function (e) { e = e || window.event; if (e.keyCode != 38 && e.keyCode != 40 && e.keyCode != 13 && e.keyCode != 27) qsFind(); };
  LT.$("qsRes").onclick = function (e) { var r = LT.up(e ? e.target : window.event.srcElement, "data-q"); if (r) qsGo(+r.getAttribute("data-q")); };
  LT.$("qs").onclick = function (e) { if ((e ? e.target : window.event.srcElement) === LT.$("qs")) closeSearch(); };
  /* once a day on opening: the bell glows (click it for the list) - nothing pops up over your work */
  window.setTimeout(function () { try { var s = LT.settings(); bell(); if (s.remind !== false && s.remindOn != LT.today() && LT.$("bellN").style.display == "block") { LT.$("bellB").className = "tb glow"; s.remindOn = LT.today(); LT.saveSettings(s); } } catch (e) { } }, 2500);
  window.setTimeout(function () { try { whatsNew(false); } catch (e) { } }, 900);
  var rt = null;
  window.onresize = function () { if (rt) window.clearTimeout(rt); rt = window.setTimeout(function () { var s = LT.settings(); s.win = { w: document.documentElement.clientWidth, h: document.documentElement.clientHeight }; LT.saveSettings(s); }, 700); };
  show(LT.settings().lastTab || "launcher");
  window.setTimeout(function () { fixHtaIcon(); try { var l = APP + "\\Lew's Toolbox.lnk"; if (!fso.FileExists(l)) makeShortcut(APP); } catch (e) { } }, 3000);
})();
</script>
</body>
</html>
