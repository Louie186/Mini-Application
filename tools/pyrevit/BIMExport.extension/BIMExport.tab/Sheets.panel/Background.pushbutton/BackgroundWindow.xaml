<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background checks  ·  by Lew" Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5" FontFamily="Segoe UI" FontSize="12.5">
<Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
        <SolidColorBrush x:Key="AccentDark" Color="#174A84"/>
        <SolidColorBrush x:Key="Ink" Color="#1F2933"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7785"/>
        <SolidColorBrush x:Key="Line" Color="#D9DEE5"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
            <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="22,14">
            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Background checks" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="  by Lew" FontSize="12" Foreground="#D3E2F4" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="A separate Revit checks your models at set times, so printing only has to export."
                               Foreground="#D3E2F4" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="state_bd" CornerRadius="10" Padding="10,3" Background="#6B7785" HorizontalAlignment="Right">
                        <TextBlock x:Name="state_tb" Text="NOT RUNNING" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="state_msg_tb" Foreground="#D3E2F4" TextAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Close" Style="{StaticResource Secondary}" Click="on_close"/>
                    <Button x:Name="pause_btn" Content="Pause" Style="{StaticResource Secondary}" Click="on_pause"
                            ToolTip="Finish the current model, then wait. Press again to continue."/>
                    <Button Content="Stop" Style="{StaticResource Secondary}" Click="on_stop"
                            ToolTip="Close the background Revit (after the current model). An unfinished check continues next time."/>
                    <Button Content="Check now" Style="{StaticResource Primary}" Click="on_check_now"
                            ToolTip="Check the ticked models now (starts the background Revit if needed)."/>
                </StackPanel>
                <TextBlock x:Name="footer_tb" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <TabControl BorderThickness="0">
                    <TabItem Header="  Models  ">
                        <Border Padding="6">
<DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="1  Models" Style="{StaticResource StepTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Tick the models to keep checked. Each line shows its last check and how many drawings need attention."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox DockPanel.Dock="Right" x:Name="show_cb" Width="120" Margin="6,0,0,0" SelectionChanged="on_show"
                                  ToolTip="Show all models, only the ticked ones, or only the ones not ticked"/>
                        <TextBox x:Name="search_tb" TextChanged="on_search" ToolTip="Filter the list by name"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Tick all" Style="{StaticResource Small}" Click="on_tick_all"
                                ToolTip="Tick every model shown (respects the search and the Show filter)"/>
                        <Button Content="Untick all" Style="{StaticResource Small}" Click="on_untick_all"
                                ToolTip="Untick every model shown (respects the search and the Show filter)"/>
                        <Button Content="What changed" Style="{StaticResource Small}" Click="on_changes"
                                ToolTip="Per model: the drawings that changed since their last issue, and why."/>
                        <Button Content="Reload selected now" Style="{StaticResource Small}" Click="on_reload"
                                ToolTip="Select model line(s), then reload them fully now (they jump the queue). Use it when you know a model changed."/>
                    </StackPanel>
                    <ListBox x:Name="models_lb" SelectionMode="Extended" BorderBrush="{StaticResource Line}"/>
                </DockPanel>
                        </Border>
                    </TabItem>
                    <TabItem Header="  Status  ">
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                       Text="Every ticked model: when it was last checked, what this check is doing with it, and whether it is open for fast printing. Refreshes by itself."/>
                            <DataGrid x:Name="status_dg" IsReadOnly="True" AutoGenerateColumns="True"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2  When" Style="{StaticResource StepTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="As many times as you like, e.g. 07:00, 10:00, 12:30, 15:00, 18:00"/>
                    <TextBox x:Name="times_tb"/>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="d1" Content="Mon" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d2" Content="Tue" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d3" Content="Wed" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d4" Content="Thu" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d5" Content="Fri" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d6" Content="Sat" Margin="0,4,10,4"/>
                        <CheckBox x:Name="d7" Content="Sun" Margin="0,4,10,4"/>
                    </WrapPanel>
                    <CheckBox x:Name="enabled_cb" Content="Schedule on" Margin="0,6,0,0"/>

                    <TextBlock Text="Fast printing" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Keep" VerticalAlignment="Center"/>
                        <ComboBox x:Name="keep_cb" Width="56" Margin="6,0"/>
                        <TextBlock Text="models open" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Open models print in seconds (export only). It pauses by itself if memory runs low."/>

                    <Button Content="Save" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="on_save"
                            ToolTip="Save the models, times and days (Windows schedule)."/>
                    <TextBlock x:Name="saved_tb" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
