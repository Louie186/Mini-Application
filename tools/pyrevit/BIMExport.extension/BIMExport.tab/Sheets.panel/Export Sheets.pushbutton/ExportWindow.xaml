<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Export" Width="1280" Height="800" MinWidth="1060" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5"
        FontFamily="Segoe UI" FontSize="12.5" ShowInTaskbar="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
        <SolidColorBrush x:Key="AccentDark" Color="#174A84"/>
        <SolidColorBrush x:Key="Ink" Color="#1F2933"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7785"/>
        <SolidColorBrush x:Key="Line" Color="#D9DEE5"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="22,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="BIM Export" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Tick models and drawings, check the settings, then export PDF and CAD."
                               Foreground="#D3E2F4" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="header_info" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#D3E2F4" TextAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Close" Style="{StaticResource Secondary}" Click="on_close"/>
                    <Button Content="Dry run" Style="{StaticResource Secondary}" Click="on_dryrun"
                            ToolTip="Instant check from the saved sheet lists. Nothing is opened or exported."/>
                    <Button x:Name="export_btn" Content="Export" Style="{StaticResource Primary}" Click="on_export"/>
                </StackPanel>
                <TextBlock x:Name="status_tb" VerticalAlignment="Center" Foreground="{StaticResource Ink}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- body -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 1 models -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="1   Models" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="ACC models known on this PC. Tick 5-10 per Revit window." Style="{StaticResource Hint}"/>
                        <TextBox x:Name="model_search" TextChanged="on_model_search" ToolTip="Filter models"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox x:Name="refresh_cb" Content="Refresh lists from the models (opens them)"/>
                        <Button Content="Load drawings  &#x25B6;" Style="{StaticResource Primary}" Margin="0,6,0,0"
                                Click="on_load" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="model_info_tb" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="models_lb" Margin="0,8,0,0" BorderBrush="{StaticResource Line}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <!-- 2 drawings -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="2   Drawings" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Grouped by model and by the sheet browser you pick for each model."
                                   Style="{StaticResource Hint}"/>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Content="Tick all" Style="{StaticResource Small}" Click="on_tick_all"/>
                                <Button Content="Clear" Style="{StaticResource Small}" Click="on_untick_all"/>
                                <Button Content="Expand" Style="{StaticResource Small}" Click="on_expand"/>
                                <Button Content="Collapse" Style="{StaticResource Small}" Click="on_collapse"/>
                                <Button Content="Tick from LOD..." Style="{StaticResource Small}" Click="on_lod"
                                        ToolTip="Tick the drawings listed in a CSV (e.g. your LOD saved as CSV UTF-8)"/>
                            </StackPanel>
                            <TextBox x:Name="sheet_search" TextChanged="on_sheet_search" ToolTip="Filter drawings by number or name"/>
                        </DockPanel>
                    </StackPanel>
                    <TreeView x:Name="sheets_tv" BorderBrush="{StaticResource Line}" Padding="4"/>
                </DockPanel>
            </Border>

            <!-- 3 settings -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="3   Settings" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Saved for next time." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TabControl BorderBrush="{StaticResource Line}">

                        <TabItem Header="  Output  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Save to" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button Content="Browse..." Style="{StaticResource Small}" DockPanel.Dock="Right"
                                                Margin="6,0,0,0" Click="on_browse"/>
                                        <TextBox x:Name="out_tb"/>
                                    </DockPanel>
                                    <CheckBox x:Name="per_model_cb" Content="One folder per model" Margin="0,8,0,0"/>

                                    <TextBlock Text="Formats" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="pdf_cb" Content="PDF"/>
                                    <CheckBox x:Name="dwg_cb" Content="DWG (CAD)"/>

                                    <TextBlock Text="File name" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="naming_tb"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="{}{SheetNumber} {SheetName} {Revision} {Model} {Date} {P:Sheet Parameter} {Project:Project Parameter}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  PDF  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Colours" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="pdf_colors_cb"/>
                                    <TextBlock Text="Raster quality" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="pdf_raster_cb"/>
                                    <CheckBox x:Name="pdf_always_raster_cb" Content="Always use raster processing" Margin="0,10,0,4"/>
                                    <TextBlock Text="Hide" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="pdf_hide_crop_cb" Content="Crop boundaries"/>
                                    <CheckBox x:Name="pdf_hide_scope_cb" Content="Scope boxes"/>
                                    <CheckBox x:Name="pdf_hide_ref_cb" Content="Reference planes"/>
                                    <CheckBox x:Name="pdf_hide_tags_cb" Content="Unreferenced view tags"/>
                                    <TextBlock Text="Or use a saved Revit PDF setup (optional)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="pdf_setup_tb" ToolTip="Exact setup name. Every model must have it."/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Paper size follows each sheet. A setup name overrides the options above."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  CAD  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="DWG version" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="dwg_version_cb"/>
                                    <TextBlock Text="Layer standard" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="dwg_layers_cb"/>
                                    <CheckBox x:Name="dwg_merged_cb" Content="One DWG per sheet (views not as xrefs)" Margin="0,10,0,4"/>
                                    <CheckBox x:Name="dwg_shared_cb" Content="Shared coordinates"/>
                                    <TextBlock Text="Or use a saved Revit DWG setup (optional)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="dwg_setup_tb" ToolTip="Exact setup name. Every model must have it."/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="A setup name overrides the options above."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="  Run  ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Logos" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="embed_cb" Content="Embed logos in the DWGs (AutoCAD, after export)"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0"
                                               Text="Finished DWGs go to the DWG folder. Revit's raw output stays in _DWG_raw."/>
                                    <TextBlock Text="Speed" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="share_cb" Content="Share with other Revit windows"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0"
                                               Text="Open another Revit, click Export Sheets there and choose Join. Each window takes the next model."/>
                                    <TextBlock Text="Models" Style="{StaticResource Label}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Workshared models open detached (all worksets, links checked) and close without saving. Nothing is synced."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
